# =========================================================================
# API KEYS CONFIGURATION (100% FREE OR SELF-HOSTED)
# =========================================================================

PORT=3000

# 1. SOCRATIC ENGINE (Gemini Free Tier)
# Generate a free API Key on Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_free_gemini_api_key

# 2. COMPUTATIONAL AUTHORITY (Wolfram Alpha Free Tier)
# Register a free account and generate an App ID (Short Answers API / Result API): https://developer.wolframalpha.com
WOLFRAM_APP_ID=your_wolfram_app_id

# 3. DIRECT SOLVER (Groq API Free Tier)
# Generate a free API Key on Groq Console: https://console.groq.com
# Default Model: deepseek-r1-distill-llama-70b (Fast reasoning model)
GROQ_API_KEY=your_free_groq_api_key

# 4. DISCORD BOT (Optional)
# Set up a bot application on: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token

# 5. TELEGRAM BOT (Optional)
# Create a bot via @BotFather on Telegram to obtain the bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token