# Required for all three front-ends — the tutor's "brain"
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required only if you run the web app
WEB_PORT=3000

# Required only if you run the Discord bot
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Required only if you run the Telegram bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
